# Generic OpenAI-compatible provider settings. If PROVIDER is omitted, Meridian
# treats API_KEY, BASE_URL, and MODEL as a custom OpenAI-compatible endpoint.
# LLM_PROVIDER, LLM_API_KEY, LLM_BASE_URL, and LLM_MODEL are aliases; generic names win when both are set.
API_KEY=replace-with-provider-api-key
BASE_URL=https://api.example.com/v1
MODEL=your-model-name
# Set true only for a trusted local/private model endpoint (for example, Ollama).
ALLOW_PRIVATE_PROVIDER_URLS=false
# Optional retrieval reranking; keep disabled unless local evaluation supports enabling it.
RERANKER=none
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Answer verification: citations (format/numeric checks), llm (judge), or off.
VERIFY_MODE=citations
# Optional remote tracing. Local request metrics remain available when disabled.
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000
# Optional: openai, anthropic, openrouter, deepseek, groq, ollama, or custom.
# PROVIDER=custom
# Optional Vite development proxy target; defaults to the local API server.
# VITE_API_PROXY_TARGET=http://localhost:8000

# Optional free OCR.space fallback for pages local Tesseract cannot read.
# Unresolved page images are sent to OCR.space when this key is present.
# OCR_API_KEY=replace-with-ocr.space-free-api-key

# Backend authentication (required in production)
API_KEY_SECRET=change-me-to-a-strong-secret
# LiteLLM gateway (required)
LITELLM_MASTER_KEY=sk-change-me
# Neo4j (required; container refuses to boot with a blank value)
NEO4J_PASSWORD=meridian-dev
# Postgres for Langfuse (required; container refuses to boot with a blank value)
POSTGRES_PASSWORD=meridian-dev
# Langfuse database connection (required when running Langfuse)
DATABASE_URL=postgresql://langfuse:meridian-dev@langfuse-db:5432/langfuse
# Langfuse auth (required when running Langfuse)
NEXTAUTH_SECRET=change-me-nextauth-secret
SALT=change-me-salt
# Optional provider routing through OmniRoute
OMNIROUTE_API_KEY=
