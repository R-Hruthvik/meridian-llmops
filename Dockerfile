FROM python:3.11-slim

ENV OMP_THREAD_LIMIT=1
ENV APP_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm tesseract-ocr tesseract-ocr-eng poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN pip install uv && uv sync --frozen --no-dev

COPY packages/ ./packages/
COPY services/ ./services/
COPY evals/ ./evals/
COPY scripts/ ./scripts/

COPY web/ ./web/
RUN npm --prefix web ci && npm --prefix web run build

# No default secrets: production boot fails closed without explicit secrets.
# Provide API_KEY_SECRET / LITELLM_MASTER_KEY at runtime (env, --env-file,
# or orchestrator secrets). Dev-only ephemeral values are generated by start.sh.

EXPOSE 8000 8001

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=4)"]

CMD ["uvicorn", "services.rag_engine.app:app", "--host", "0.0.0.0", "--port", "8000"]
